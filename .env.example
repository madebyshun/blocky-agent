VIRTUALS_API_KEY=          # REQUIRED — the only LLM gateway (compute.virtuals.io). See api/_lib/llm.ts
VIRTUALS_MODEL=            # Optional — pin a model id; validated against the live Virtuals catalog

BANKR_API_KEY=             # Legacy — llm.bankr.bot is 403-banned; still read by launch-token + badge
BASESCAN_API_KEY=

# Telegram — Blue Hood alerts (one webhook per token)
TELEGRAM_BOT_TOKEN=        # BotFather token for BlueAgent bot
TELEGRAM_CHAT_ID=          # Channel/group ID (e.g. -100xxxxxxxxx or @blueagent_hub)

CRON_SECRET=               # Random string protecting /api/cron/* (blue-hood, research-loop, run)
