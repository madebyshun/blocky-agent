# ─── Claim artifacts generated by apps/web/scripts/build-merkle.ts ───────────
# Ignored by default so that a fixture or dry-run build can never be committed
# and served from blueagent.dev as if it were the real allocation table. The
# REAL ones are added deliberately at launch with `git add -f` — see
# claim-data/RUNBOOK.md step 1.
claim-data/tree.json
claim-data/root.txt
claim-data/summary.txt
apps/web/public/claim-data/proofs.json

# The throwaway deployer key for the testnet dry run. Already covered by the
# `.env.*` rule above, and repeated here on purpose: that rule matches this
# file by coincidence of naming, and a private key should not be protected by
# a coincidence. The dry-run RECEIPTS (claim-data/dryrun/*.json) are NOT
# ignored — they are the evidence the dry run happened and are meant to ship.
claim-data/dryrun/.env.deployer
